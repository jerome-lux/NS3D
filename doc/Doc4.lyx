\begin_layout Standard
Algorithme basé sur 3 étapes comprenant des sous-itérations.
\end_layout

\begin_layout Enumerate
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
'E
\end_layout

\end_inset

tape 1: 
